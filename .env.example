# Copy to .env.local and fill in. .env.local is never committed.
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Google Maps JavaScript API + Places API (New) key, restricted to your site address.
# Without it the booking form uses the free OpenStreetMap map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email (Resend). Server-only: never prefix with NEXT_PUBLIC_.
# EMAIL_FROM must use the domain verified in Resend, e.g. HandyCorp <hello@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
# The public address of the site, used for the links inside emails, e.g. https://handycorp.vercel.app
NEXT_PUBLIC_SITE_URL=
