# Copy to .env.local and fill in. .env.local is never committed.
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Google Maps JavaScript API + Places API (New) key, restricted to your site address.
# Without it the booking form uses the free OpenStreetMap map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
